AZDO_ORGANIZATION=https://dev.azure.com/example
AZDO_PROJECT=ExampleProject
AZDO_TOKEN=replace-me
AZDO_WEBHOOK_SECRET=replace-me
AZDO_REPOSITORIES=repository-id-or-name
AZDO_TRACKED_REFS=refs/heads/main
AZDO_RELEASE_TAG_PREFIX=refs/tags/
AZDO_WORK_ITEM_TYPES=Product Backlog Item,User Story,Bug
RECONCILIATION_INTERVAL_SECONDS=300
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=granite4:3b
LOCAL_EMBEDDING_MODEL=granite-embedding:30m
MCP_JWT_JWKS_URI=https://login.example/.well-known/jwks.json
MCP_JWT_ISSUER=https://login.example/
MCP_JWT_AUDIENCE=know-your-project
MCP_RESOURCE_SERVER_URL=http://localhost:8000/mcp
MCP_REQUIRED_SCOPES=
CHECKPOINT_DB=./data/state.db
GRAPHITI_TELEMETRY_ENABLED=false
